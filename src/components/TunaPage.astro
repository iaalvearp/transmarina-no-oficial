---
import Eyebrow from './Eyebrow.astro'
import Icon from './Icon.astro'

const products = [
  { number: '01', name: 'Lomo', english: 'Loin', detail: 'Corte limpio y versátil, ideal para aplicaciones de alto valor.' },
  { number: '02', name: 'Porción', english: 'Portion', detail: 'Porciones uniformes preparadas para una presentación precisa.' },
  { number: '03', name: 'Saku block', english: 'Saku block', detail: 'Bloques rectangulares seleccionados para cortes consistentes.' },
  { number: '04', name: 'Ventresca sin piel', english: 'Skinless belly', detail: 'Textura delicada, preparada sin piel.' },
  { number: '05', name: 'Filete', english: 'Steak', detail: 'Corte tradicional con calidad sashimi y congelación cuidada.' },
  { number: '06', name: 'Tataki', english: 'Tataki', detail: 'Formato pensado para una preparación breve y una textura singular.' },
]
---

<main class="inner-page">
  <section class="page-hero tuna-page-hero">
    <div class="page-hero-copy">
      <Eyebrow>Productos · 01</Eyebrow>
      <h1>Atún de<br /><em>origen.</em></h1>
      <p class="page-lead">La calidad sashimi es nuestro negocio. Selección, conocimiento y congelación para llevar la esencia del Pacífico más lejos.</p>
      <a class="text-link" href="#cortes">Explorar presentaciones <Icon name="arrow-right" size={15} /></a>
    </div>
    <div class="page-hero-photo">
      <img src="/tuna-loin.png" alt="Lomo fresco de atún seleccionado para calidad sashimi" width="1200" height="896" loading="lazy" />
      <div class="photo-stamp"><Icon name="snowflake" size={16} /><span>ULTRA<br />CONGELADO</span></div>
      <span class="photo-index">THUNNUS · PACIFIC OCEAN</span>
    </div>
  </section>

  <section class="species-band">
    <div class="species-label"><span>ESPECIES</span><span>01 — 03</span></div>
    <div class="species-item"><strong>Bigeye</strong><em>Thunnus obesus</em></div>
    <div class="species-item"><strong>Yellowfin</strong><em>Thunnus albacares</em></div>
    <div class="species-item"><strong>Skipjack</strong><em>Katsuwonus pelamis</em></div>
  </section>

  <section class="cuts-section section-shell" id="cortes">
    <div class="section-head-row">
      <div><Eyebrow>Una línea versátil</Eyebrow><h2>Cortes pensados<br />para <em>cada mercado.</em></h2></div>
      <p>Atención personalizada y flexibilidad para adaptar los productos a las necesidades de cada cliente.</p>
    </div>
    <div class="cuts-grid">
      {products.map((product) => (
        <article class="cut-card">
          <span class="cut-number">{product.number}</span>
          <span class="cut-rule"></span>
          <h3>{product.name}</h3>
          <span class="cut-english">{product.english}</span>
          <p>{product.detail}</p>
          <span class="cut-arrow" aria-hidden="true"><Icon name="arrow-up-right" size={16} /></span>
        </article>
      ))}
    </div>
  </section>

  <section class="packaging-section">
    <div class="packaging-copy">
      <Eyebrow light>Adaptabilidad en cada entrega</Eyebrow>
      <h2>Presentaciones<br />a la medida <em>de tu operación.</em></h2>
      <p>Enfundado individual, vacío o a granel: distintas alternativas de empaque y formatos de caja para responder a cada requerimiento.</p>
      <a class="quiet-link quiet-link-light" href="https://transmarina.com" target="_blank">Conversemos sobre tu necesidad <Icon name="arrow-right" size={15} /></a>
    </div>
    <div class="packaging-options">
      <div><span>01</span><strong>IVP</strong><small>Individual Vacuum Pack</small></div>
      <div><span>02</span><strong>WP</strong><small>Individual Wrap Pack</small></div>
      <div><span>03</span><strong>BVP / BP</strong><small>Bulk Vacuum Pack · Bulk Pack</small></div>
      <div class="box-sizes"><span>FORMATOS DE CAJA</span><strong>2 <i>·</i> 5 <i>·</i> 10 <i>·</i> 25 <i>·</i> 30 <small>kg</small></strong><small>Cartón o caja térmica</small></div>
    </div>
  </section>

  <section class="trace-section section-shell">
    <div class="trace-symbol"><Icon name="snowflake" size={28} /></div>
    <div><Eyebrow>Frescura en su punto</Eyebrow><h2>La temperatura<br />también cuenta.</h2></div>
    <p>Nuestras cámaras de congelación a −18 °C contribuyen a preservar la frescura y calidad de cada producto.</p>
    <a class="text-link" href="/content/certificaciones">Calidad y certificaciones <Icon name="arrow-right" size={15} /></a>
  </section>
</main>
